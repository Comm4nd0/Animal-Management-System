# Copy this file to terraform.tfvars and fill in your values
# cp terraform.tfvars.example terraform.tfvars

aws_region          = "us-east-1"
instance_type       = "t4g.small"      # ~$12/month (ARM, 2 vCPU, 2GB RAM)
ssh_public_key_path = "~/.ssh/id_rsa.pub"
ebs_volume_size     = 20               # GB

# Required secrets
db_password      = "CHANGE_ME_strong_password_here"
django_secret_key = "CHANGE_ME_use_python_c_from_django.core.management.utils_import_get_random_secret_key_print_get_random_secret_key"

# Restrict SSH access to your IP (recommended)
# Find your IP: curl ifconfig.me
# allowed_ssh_cidrs = ["YOUR_IP/32"]
