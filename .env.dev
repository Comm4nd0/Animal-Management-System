# ─── Development Environment Variables ────────────────────
# This file is used by docker-compose.dev.yml
# Safe defaults — never use these values in production

DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (local Docker PostgreSQL)
DB_NAME=pedigree_db
DB_USER=pedigree_admin
DB_PASSWORD=localdevpassword
DB_HOST=db
DB_PORT=5432

USE_SQLITE=False

# CORS — allow everything in dev
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AWS S3 disabled in dev — media stored locally
USE_S3=False
